exports[`fromLexicon > should generate a definitions module with tokens and known values 1`] = `
"// Generated from the com.atproto.label.defs Lexicon by Valicon. Do not edit.
import * as v from "valibot";
import * as lex from "valicon";

/**
 * Metadata tag on an atproto resource (eg, repo or record).
 */
export const label = v.pipe(
  lex.object("com.atproto.label.defs#label", {
    ver: v.optional(
      v.pipe(
        v.number(),
        v.integer(),
        v.description("The AT Protocol version of the label object.")
      )
    ),
    src: v.pipe(
      v.string(),
      lex.did(),
      v.description("DID of the actor who created this label.")
    ),
    uri: v.pipe(
      v.string(),
      lex.uri(),
      v.description(
        "AT URI of the record, repository (account), or other resource that this label applies to."
      )
    ),
    cid: v.optional(
      v.pipe(
        v.string(),
        lex.cid(),
        v.description(
          "Optionally, CID specifying the specific version of 'uri' resource this label applies to."
        )
      )
    ),
    val: v.pipe(
      v.string(),
      v.maxBytes(128),
      v.description("The short string name of the value or type of this label.")
    ),
    neg: v.optional(
      v.pipe(
        v.boolean(),
        v.description(
          "If true, this is a negation label, overwriting a previous label."
        )
      )
    ),
    cts: v.pipe(
      v.string(),
      lex.datetime(),
      v.description("Timestamp when this label was created.")
    ),
    exp: v.optional(
      v.pipe(
        v.string(),
        lex.datetime(),
        v.description(
          "Timestamp at which this label expires (no longer applies)."
        )
      )
    ),
    sig: v.optional(
      v.pipe(lex.bytes(), v.description("Signature of dag-cbor encoded label."))
    )
  }),
  v.description("Metadata tag on an atproto resource (eg, repo or record).")
);

/**
 * Metadata tag on an atproto record, published by the author within the record. Note that schemas should use #selfLabels, not #selfLabel.
 */
export const selfLabel = v.pipe(
  lex.object("com.atproto.label.defs#selfLabel", {
    val: v.pipe(
      v.string(),
      v.maxBytes(128),
      v.description("The short string name of the value or type of this label.")
    )
  }),
  v.description(
    "Metadata tag on an atproto record, published by the author within the record. Note that schemas should use #selfLabels, not #selfLabel."
  )
);

/**
 * Metadata tags on an atproto record, published by the author within the record.
 */
export const selfLabels = v.pipe(
  lex.object("com.atproto.label.defs#selfLabels", { values: v.pipe(v.array(selfLabel), v.maxLength(10)) }),
  v.description(
    "Metadata tags on an atproto record, published by the author within the record."
  )
);

/**
 * Strings which describe the label in the UI, localized into a specific language.
 */
export const labelValueDefinitionStrings = v.pipe(
  lex.object("com.atproto.label.defs#labelValueDefinitionStrings", {
    lang: v.pipe(
      v.string(),
      lex.language(),
      v.description("The code of the language these strings are written in.")
    ),
    name: v.pipe(
      v.string(),
      v.maxBytes(640),
      v.maxGraphemes(64),
      v.description("A short human-readable name for the label.")
    ),
    description: v.pipe(
      v.string(),
      v.maxBytes(100000),
      v.maxGraphemes(10000),
      v.description(
        "A longer description of what the label means and why it might be applied."
      )
    )
  }),
  v.description(
    "Strings which describe the label in the UI, localized into a specific language."
  )
);

/**
 * Declares a label value and its expected interpretations and behaviors.
 */
export const labelValueDefinition = v.pipe(
  lex.object("com.atproto.label.defs#labelValueDefinition", {
    identifier: v.pipe(
      v.string(),
      v.maxBytes(100),
      v.maxGraphemes(100),
      v.description(
        "The value of the label being defined. Must only include lowercase ascii and the '-' character ([a-z-]+)."
      )
    ),
    severity: v.pipe(
      v.string(),
      lex.knownValues(["inform", "alert", "none"]),
      v.description(
        "How should a client visually convey this label? 'inform' means neutral and informational; 'alert' means negative and warning; 'none' means show nothing."
      )
    ),
    blurs: v.pipe(
      v.string(),
      lex.knownValues(["content", "media", "none"]),
      v.description(
        "What should this label hide in the UI, if applied? 'content' hides all of the target; 'media' hides the images/video/audio; 'none' hides nothing."
      )
    ),
    defaultSetting: v.optional(
      v.pipe(
        v.string(),
        lex.knownValues(["ignore", "warn", "hide"]),
        v.description("The default setting for this label.")
      ),
      "warn"
    ),
    adultOnly: v.optional(
      v.pipe(
        v.boolean(),
        v.description(
          "Does the user need to have adult content enabled in order to configure this label?"
        )
      )
    ),
    locales: v.array(labelValueDefinitionStrings)
  }),
  v.description(
    "Declares a label value and its expected interpretations and behaviors."
  )
);

export const labelValue = v.pipe(
  v.string(),
  lex.knownValues([
    "!hide",
    "!warn",
    "!no-unauthenticated",
    "porn",
    "sexual",
    "nudity",
    "graphic-media",
    "bot"
  ]),
  lex.id("com.atproto.label.defs#labelValue")
);
"
`;

exports[`fromLexicon > should generate a query module 1`] = `
"// Generated from the app.bsky.feed.getPosts Lexicon by Valicon. Do not edit.
import * as v from "valibot";
import * as lex from "valicon";
import * as AppBskyFeedDefs from "./app.bsky.feed.defs.js";

/**
 * Gets post views for a specified list of posts (by AT-URI). This is sometimes referred to as 'hydrating' a 'feed skeleton'.
 */
export const main = lex.query("app.bsky.feed.getPosts", {
  description: "Gets post views for a specified list of posts (by AT-URI). This is sometimes referred to as 'hydrating' a 'feed skeleton'.",
  parameters: v.looseObject({
    uris: v.pipe(
      v.array(v.pipe(v.string(), lex.atUri())),
      v.maxLength(25),
      v.description("List of post AT-URIs to return hydrated views for.")
    )
  }),
  output: {
    encoding: "application/json",
    schema: v.looseObject({ posts: v.array(v.lazy(() => AppBskyFeedDefs.postView)) })
  }
});
"
`;

exports[`fromLexicon > should generate a record module 1`] = `
"// Generated from the app.bsky.feed.post Lexicon by Valicon. Do not edit.
import * as v from "valibot";
import * as lex from "valicon";
import * as AppBskyEmbedExternal from "./app.bsky.embed.external.js";
import * as AppBskyEmbedGallery from "./app.bsky.embed.gallery.js";
import * as AppBskyEmbedImages from "./app.bsky.embed.images.js";
import * as AppBskyEmbedRecord from "./app.bsky.embed.record.js";
import * as AppBskyEmbedRecordWithMedia from "./app.bsky.embed.recordWithMedia.js";
import * as AppBskyEmbedVideo from "./app.bsky.embed.video.js";
import * as AppBskyRichtextFacet from "./app.bsky.richtext.facet.js";
import * as ComAtprotoLabelDefs from "./com.atproto.label.defs.js";
import * as ComAtprotoRepoStrongRef from "./com.atproto.repo.strongRef.js";

/**
 * Deprecated. Use app.bsky.richtext instead -- A text segment. Start is inclusive, end is exclusive. Indices are for utf16-encoded strings.
 */
export const textSlice = v.pipe(
  lex.object("app.bsky.feed.post#textSlice", {
    start: v.pipe(v.number(), v.integer(), v.minValue(0)),
    end: v.pipe(v.number(), v.integer(), v.minValue(0))
  }),
  v.description(
    "Deprecated. Use app.bsky.richtext instead -- A text segment. Start is inclusive, end is exclusive. Indices are for utf16-encoded strings."
  )
);

/**
 * Deprecated: use facets instead.
 */
export const entity = v.pipe(
  lex.object("app.bsky.feed.post#entity", {
    index: textSlice,
    type: v.pipe(
      v.string(),
      v.description("Expected values are 'mention' and 'link'.")
    ),
    value: v.string()
  }),
  v.description("Deprecated: use facets instead.")
);

export const replyRef = lex.object("app.bsky.feed.post#replyRef", {
  root: v.lazy(() => ComAtprotoRepoStrongRef.main),
  parent: v.lazy(() => ComAtprotoRepoStrongRef.main)
});

/**
 * Record containing a Bluesky post.
 */
export const main = v.pipe(
  lex.record(
    "app.bsky.feed.post",
    {
      text: v.pipe(
        v.string(),
        v.maxBytes(3000),
        v.maxGraphemes(300),
        v.description(
          "The primary post content. May be an empty string, if there are embeds."
        )
      ),
      entities: v.optional(
        v.pipe(
          v.array(entity),
          v.description("DEPRECATED: replaced by app.bsky.richtext.facet.")
        )
      ),
      facets: v.optional(
        v.pipe(
          v.array(v.lazy(() => AppBskyRichtextFacet.main)),
          v.description("Annotations of text (mentions, URLs, hashtags, etc)")
        )
      ),
      reply: v.optional(replyRef),
      embed: v.optional(
        lex.union([
          v.lazy(() => AppBskyEmbedImages.main),
          v.lazy(() => AppBskyEmbedVideo.main),
          v.lazy(() => AppBskyEmbedGallery.main),
          v.lazy(() => AppBskyEmbedExternal.main),
          v.lazy(() => AppBskyEmbedRecord.main),
          v.lazy(() => AppBskyEmbedRecordWithMedia.main)
        ])
      ),
      langs: v.optional(
        v.pipe(
          v.array(v.pipe(v.string(), lex.language())),
          v.maxLength(3),
          v.description(
            "Indicates human language of post primary text content."
          )
        )
      ),
      labels: v.optional(
        v.pipe(
          lex.union([v.lazy(() => ComAtprotoLabelDefs.selfLabels)]),
          v.description(
            "Self-label values for this post. Effectively content warnings."
          )
        )
      ),
      tags: v.optional(
        v.pipe(
          v.array(v.pipe(v.string(), v.maxBytes(640), v.maxGraphemes(64))),
          v.maxLength(8),
          v.description(
            "Additional hashtags, in addition to any included in post text and facets."
          )
        )
      ),
      createdAt: v.pipe(
        v.string(),
        lex.datetime(),
        v.description(
          "Client-declared timestamp when this post was originally created."
        )
      )
    },
    { key: "tid" }
  ),
  v.description("Record containing a Bluesky post.")
);
"
`;

exports[`fromLexicon > should generate a subscription module with nullable fields 1`] = `
"// Generated from the com.atproto.sync.subscribeRepos Lexicon by Valicon. Do not edit.
import * as v from "valibot";
import * as lex from "valicon";

/**
 * A repo operation, ie a mutation of a single record.
 */
export const repoOp = v.pipe(
  lex.object("com.atproto.sync.subscribeRepos#repoOp", {
    action: v.pipe(v.string(), lex.knownValues(["create", "update", "delete"])),
    path: v.string(),
    cid: v.nullable(
      v.pipe(
        lex.cidLink(),
        v.description(
          "For creates and updates, the new record CID. For deletions, null."
        )
      )
    ),
    prev: v.optional(
      v.pipe(
        lex.cidLink(),
        v.description(
          "For updates and deletes, the previous record CID (required for inductive firehose). For creations, field should not be defined."
        )
      )
    )
  }),
  v.description("A repo operation, ie a mutation of a single record.")
);

/**
 * Represents an update of repository state. Note that empty commits are allowed, which include no repo data changes, but an update to rev and signature.
 */
export const commit = v.pipe(
  lex.object("com.atproto.sync.subscribeRepos#commit", {
    seq: v.pipe(
      v.number(),
      v.integer(),
      v.description("The stream sequence number of this message.")
    ),
    rebase: v.pipe(v.boolean(), v.description("DEPRECATED -- unused")),
    tooBig: v.pipe(
      v.boolean(),
      v.description(
        "DEPRECATED -- replaced by #sync event and data limits. Indicates that this commit contained too many ops, or data size was too large. Consumers will need to make a separate request to get missing data."
      )
    ),
    repo: v.pipe(
      v.string(),
      lex.did(),
      v.description(
        "The repo this event comes from. Note that all other message types name this field 'did'."
      )
    ),
    commit: v.pipe(lex.cidLink(), v.description("Repo commit object CID.")),
    rev: v.pipe(
      v.string(),
      lex.tid(),
      v.description(
        "The rev of the emitted commit. Note that this information is also in the commit object included in blocks, unless this is a tooBig event."
      )
    ),
    since: v.nullable(
      v.pipe(
        v.string(),
        lex.tid(),
        v.description(
          "The rev of the last emitted commit from this repo (if any)."
        )
      )
    ),
    blocks: v.pipe(
      lex.bytes({ maxLength: 2000000 }),
      v.description(
        "CAR file containing relevant blocks, as a diff since the previous repo state. The commit must be included as a block, and the commit block CID must be the first entry in the CAR header 'roots' list."
      )
    ),
    ops: v.pipe(
      v.array(
        v.pipe(
          repoOp,
          v.description(
            "List of repo mutation operations in this commit (eg, records created, updated, or deleted)."
          )
        )
      ),
      v.maxLength(200)
    ),
    blobs: v.array(
      v.pipe(
        lex.cidLink(),
        v.description(
          "DEPRECATED -- will soon always be empty. List of new blobs (by CID) referenced by records in this commit."
        )
      )
    ),
    prevData: v.optional(
      v.pipe(
        lex.cidLink(),
        v.description(
          "The root CID of the MST tree for the previous commit from this repo (indicated by the 'since' revision field in this message). Corresponds to the 'data' field in the repo commit object. NOTE: this field is effectively required for the 'inductive' version of firehose."
        )
      )
    ),
    time: v.pipe(
      v.string(),
      lex.datetime(),
      v.description("Timestamp of when this message was originally broadcast.")
    )
  }),
  v.description(
    "Represents an update of repository state. Note that empty commits are allowed, which include no repo data changes, but an update to rev and signature."
  )
);

/**
 * Updates the repo to a new state, without necessarily including that state on the firehose. Used to recover from broken commit streams, data loss incidents, or in situations where upstream host does not know recent state of the repository.
 */
export const sync = v.pipe(
  lex.object("com.atproto.sync.subscribeRepos#sync", {
    seq: v.pipe(
      v.number(),
      v.integer(),
      v.description("The stream sequence number of this message.")
    ),
    did: v.pipe(
      v.string(),
      lex.did(),
      v.description(
        "The account this repo event corresponds to. Must match that in the commit object."
      )
    ),
    blocks: v.pipe(
      lex.bytes({ maxLength: 10000 }),
      v.description(
        "CAR file containing the commit, as a block. The CAR header must include the commit block CID as the first 'root'."
      )
    ),
    rev: v.pipe(
      v.string(),
      v.description(
        "The rev of the commit. This value must match that in the commit object."
      )
    ),
    time: v.pipe(
      v.string(),
      lex.datetime(),
      v.description("Timestamp of when this message was originally broadcast.")
    )
  }),
  v.description(
    "Updates the repo to a new state, without necessarily including that state on the firehose. Used to recover from broken commit streams, data loss incidents, or in situations where upstream host does not know recent state of the repository."
  )
);

/**
 * Represents a change to an account's identity. Could be an updated handle, signing key, or pds hosting endpoint. Serves as a prod to all downstream services to refresh their identity cache.
 */
export const identity = v.pipe(
  lex.object("com.atproto.sync.subscribeRepos#identity", {
    seq: v.pipe(v.number(), v.integer()),
    did: v.pipe(v.string(), lex.did()),
    time: v.pipe(v.string(), lex.datetime()),
    handle: v.optional(
      v.pipe(
        v.string(),
        lex.handle(),
        v.description(
          "The current handle for the account, or 'handle.invalid' if validation fails. This field is optional, might have been validated or passed-through from an upstream source. Semantics and behaviors for PDS vs Relay may evolve in the future; see atproto specs for more details."
        )
      )
    )
  }),
  v.description(
    "Represents a change to an account's identity. Could be an updated handle, signing key, or pds hosting endpoint. Serves as a prod to all downstream services to refresh their identity cache."
  )
);

/**
 * Represents a change to an account's status on a host (eg, PDS or Relay). The semantics of this event are that the status is at the host which emitted the event, not necessarily that at the currently active PDS. Eg, a Relay takedown would emit a takedown with active=false, even if the PDS is still active.
 */
export const account = v.pipe(
  lex.object("com.atproto.sync.subscribeRepos#account", {
    seq: v.pipe(v.number(), v.integer()),
    did: v.pipe(v.string(), lex.did()),
    time: v.pipe(v.string(), lex.datetime()),
    active: v.pipe(
      v.boolean(),
      v.description(
        "Indicates that the account has a repository which can be fetched from the host that emitted this event."
      )
    ),
    status: v.optional(
      v.pipe(
        v.string(),
        lex.knownValues([
          "takendown",
          "suspended",
          "deleted",
          "deactivated",
          "desynchronized",
          "throttled"
        ]),
        v.description(
          "If active=false, this optional field indicates a reason for why the account is not active."
        )
      )
    )
  }),
  v.description(
    "Represents a change to an account's status on a host (eg, PDS or Relay). The semantics of this event are that the status is at the host which emitted the event, not necessarily that at the currently active PDS. Eg, a Relay takedown would emit a takedown with active=false, even if the PDS is still active."
  )
);

export const info = lex.object("com.atproto.sync.subscribeRepos#info", {
  name: v.pipe(v.string(), lex.knownValues(["OutdatedCursor"])),
  message: v.optional(v.string())
});

/**
 * Repository event stream, aka Firehose endpoint. Outputs repo commits with diff data, and identity update events, for all repositories on the current server. See the atproto specifications for details around stream sequencing, repo versioning, CAR diff format, and more. Public and does not require auth; implemented by PDS and Relay.
 */
export const main = lex.subscription("com.atproto.sync.subscribeRepos", {
  description: "Repository event stream, aka Firehose endpoint. Outputs repo commits with diff data, and identity update events, for all repositories on the current server. See the atproto specifications for details around stream sequencing, repo versioning, CAR diff format, and more. Public and does not require auth; implemented by PDS and Relay.",
  parameters: v.looseObject({
    cursor: v.optional(
      v.pipe(
        v.number(),
        v.integer(),
        v.description("The last known event seq number to backfill from.")
      )
    )
  }),
  message: { schema: lex.union([commit, sync, identity, account, info]) },
  errors: [
    { name: "FutureCursor" },
    {
      name: "ConsumerTooSlow",
      description: "If the consumer of the stream can not keep up with events, and a backlog gets too large, the server will drop the connection."
    }
  ]
});
"
`;
