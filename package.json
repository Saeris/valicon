{
  "name": "valicon",
  "version": "0.0.0",
  "description": "Valibot schemas, codegen, and mocking utilities for AT Protocol Lexicons",
  "keywords": [
    "valibot",
    "atproto",
    "at-protocol",
    "lexicon",
    "bluesky",
    "schema",
    "validation",
    "codegen",
    "valimock"
  ],
  "homepage": "https://github.com/Saeris/valicon#readme",
  "license": "MIT",
  "author": "Drake Costa <drake@saeris.io> (https://saeris.gg)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Saeris/valicon.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./valimock": {
      "types": "./dist/valimock.d.mts",
      "default": "./dist/valimock.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "fledgling": {
    "provider": "github",
    "workflow": "release.yml",
    "environment": "publish",
    "publish": true
  },
  "peerDependencies": {
    "@faker-js/faker": ">=9.0.0",
    "valibot": "^1.5.0",
    "valimock": ">=1.6.0"
  },
  "peerDependenciesMeta": {
    "@faker-js/faker": {
      "optional": true
    },
    "valimock": {
      "optional": true
    }
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@saeris/configs": "^1.6.1",
    "@types/node": "^26.6.6",
    "@varlock/bumpy": "^1.19.0",
    "@vitest/coverage-v8": "catalog:",
    "deoptkit": "^0.1.0",
    "typescript": "^6.0.3",
    "valibot": "^1.5.0",
    "valimock": "^1.6.0",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "resolutions": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "yarn@4.18.1"
}
